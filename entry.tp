{
  "api": 10,
  "version": 141,
  "name": "Alexa Control",
  "id": "alexacontrol",
  "configuration": {
    "colorDark": "#0B3D4F",
    "colorLight": "#00A8E1",
    "parentCategory": "homeautomation"
  },
  "plugin_start_cmd_windows": "node \"%TP_PLUGIN_FOLDER%AlexaControl\\src\\index.js\"",
  "plugin_start_cmd_mac": "node \"%TP_PLUGIN_FOLDER%AlexaControl/src/index.js\"",
  "plugin_start_cmd_linux": "node \"%TP_PLUGIN_FOLDER%AlexaControl/src/index.js\"",
  "plugin_start_cmd": "node \"%TP_PLUGIN_FOLDER%AlexaControl/src/index.js\"",
  "settingsDescription": "# Alexa Control\nControls Amazon Echo devices. The Alexa backend uses the unofficial alexa-remote2 library and can stop working when Amazon changes things. Voice Monkey is the official, limited backup.\n# First Amazon login\n1. Pick your Amazon region and save.\n2. Press a button with the action \"Open Amazon login page\". The login page opens in a browser on this PC (not on your tablet).\n3. Sign in to Amazon. The plugin saves the login (in %APPDATA%\\AlexaControl-TouchPortal) and reuses it after restarts and updates.\n# Am I connected?\nSee \"Alexa connection\" below (Connected or Disconnected). Reopen this page to refresh it.",
  "settings": [
    {
      "name": "Alexa connection",
      "type": "text",
      "default": "Connecting...",
      "readOnly": true,
      "tooltip": { "title": "Alexa connection", "body": "Filled in by the plugin: Connected, Connecting..., Disconnected (with the reason) or Off. Reopen the settings page to refresh it." }
    },
    {
      "name": "Amazon login page",
      "type": "text",
      "default": "(not needed)",
      "readOnly": true,
      "tooltip": { "title": "Amazon login page", "body": "Filled in by the plugin when a login is needed. Open it in a browser on this PC, or press the action \"Open Amazon login page\"." }
    },
    {
      "name": "Alexa backend enabled",
      "type": "switch",
      "default": "On",
      "tooltip": { "title": "Alexa backend", "body": "Turn the unofficial Amazon Alexa connection on or off." }
    },
    {
      "name": "Amazon region",
      "type": "choice",
      "default": "United States (amazon.com)",
      "choices": [
        "United States (amazon.com)",
        "United Kingdom (amazon.co.uk)",
        "Canada (amazon.ca)",
        "Australia (amazon.com.au)",
        "India (amazon.in)",
        "Germany (amazon.de)",
        "France (amazon.fr)",
        "Italy (amazon.it)",
        "Spain (amazon.es)",
        "Mexico (amazon.com.mx)",
        "Brazil (amazon.com.br)",
        "Japan (amazon.co.jp)"
      ],
      "tooltip": { "title": "Amazon region", "body": "The Amazon site your Alexa account belongs to. Changing it requires a new login." }
    },
    {
      "name": "Login proxy address",
      "type": "text",
      "default": "127.0.0.1",
      "maxLength": 100,
      "tooltip": { "title": "Login proxy address", "body": "The address you will type in the browser to log in. Keep 127.0.0.1 to log in from this PC. Use this PC's LAN IP only if you must log in from another computer." }
    },
    {
      "name": "Login proxy port",
      "type": "number",
      "default": "3456",
      "minValue": 1024,
      "maxValue": 65535,
      "tooltip": { "title": "Login proxy port", "body": "Port for the temporary Amazon login page. Change it only if 3456 is already in use." }
    },
    {
      "name": "Voice Monkey enabled",
      "type": "switch",
      "default": "Off",
      "tooltip": { "title": "Voice Monkey", "body": "Turn the official Voice Monkey backend on or off." }
    },
    {
      "name": "Voice Monkey token",
      "type": "text",
      "default": "",
      "isPassword": true,
      "maxLength": 200,
      "tooltip": { "title": "Voice Monkey token", "body": "API token from the Voice Monkey console (API Tokens page)." }
    },
    {
      "name": "Log level",
      "type": "choice",
      "default": "info",
      "choices": ["error", "warn", "info", "debug"],
      "tooltip": { "title": "Log level", "body": "How much is written to logs/plugin.log in the plugin folder. Secrets are always removed." }
    }
  ],
  "categories": [
    {
      "id": "alexacontrol.cat.main",
      "name": "Alexa Control",
      "imagepath": "%TP_PLUGIN_FOLDER%AlexaControl/images/alexa.png",
      "subCategories": [
        { "id": "alexacontrol.sub.speech", "name": "Speech", "imagepath": "%TP_PLUGIN_FOLDER%AlexaControl/images/alexa.png" },
        { "id": "alexacontrol.sub.media", "name": "Media and volume", "imagepath": "%TP_PLUGIN_FOLDER%AlexaControl/images/alexa.png" },
        { "id": "alexacontrol.sub.routines", "name": "Routines, timers and Do Not Disturb", "imagepath": "%TP_PLUGIN_FOLDER%AlexaControl/images/alexa.png" },
        { "id": "alexacontrol.sub.smarthome", "name": "Smart home", "imagepath": "%TP_PLUGIN_FOLDER%AlexaControl/images/alexa.png" },
        { "id": "alexacontrol.sub.voicemonkey", "name": "Voice Monkey", "imagepath": "%TP_PLUGIN_FOLDER%AlexaControl/images/alexa.png" },
        { "id": "alexacontrol.sub.plugin", "name": "Plugin and login", "imagepath": "%TP_PLUGIN_FOLDER%AlexaControl/images/alexa.png" }
      ],
      "actions": [
        {
          "id": "alexacontrol.act.speak",
          "name": "Speak or announce text",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.speech",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "{$alexacontrol.data.speakMode$} on {$alexacontrol.data.deviceOrAll$}" },
            { "lineFormat": "Text {$alexacontrol.data.text$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.speakMode", "type": "choice", "label": "Mode", "default": "Speak", "valueChoices": ["Speak", "Announce"] },
            { "id": "alexacontrol.data.deviceOrAll", "type": "choice", "label": "Echo", "default": "All Echos", "valueChoices": ["All Echos"] },
            { "id": "alexacontrol.data.text", "type": "text", "label": "Text", "default": "" }
          ]
        },
        {
          "id": "alexacontrol.act.tellAlexa",
          "name": "Tell Alexa (any phrase)",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.speech",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Tell Alexa on {$alexacontrol.data.device$}" },
            { "lineFormat": "Phrase {$alexacontrol.data.text$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.device", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] },
            { "id": "alexacontrol.data.text", "type": "text", "label": "Phrase", "default": "what time is it" }
          ]
        },
        {
          "id": "alexacontrol.act.media",
          "name": "Media control",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.media",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "{$alexacontrol.data.mediaCommand$} on {$alexacontrol.data.device$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.mediaCommand", "type": "choice", "label": "Command", "default": "Play", "valueChoices": ["Play", "Pause", "Next", "Previous"] },
            { "id": "alexacontrol.data.device", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] }
          ]
        },
        {
          "id": "alexacontrol.act.setVolume",
          "name": "Set volume",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.media",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Set volume of {$alexacontrol.data.deviceOrAll$} to {$alexacontrol.data.volume$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.deviceOrAll", "type": "choice", "label": "Echo", "default": "All Echos", "valueChoices": ["All Echos"] },
            { "id": "alexacontrol.data.volume", "type": "number", "label": "Volume", "default": 30, "minValue": 0, "maxValue": 100, "allowDecimals": false }
          ]
        },
        {
          "id": "alexacontrol.act.stepVolume",
          "name": "Volume up or down",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.media",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Volume {$alexacontrol.data.direction$} by {$alexacontrol.data.step$} on {$alexacontrol.data.device$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.direction", "type": "choice", "label": "Direction", "default": "Up", "valueChoices": ["Up", "Down"] },
            { "id": "alexacontrol.data.step", "type": "number", "label": "Step", "default": 10, "minValue": 1, "maxValue": 100, "allowDecimals": false },
            { "id": "alexacontrol.data.device", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] }
          ]
        },
        {
          "id": "alexacontrol.act.dnd",
          "name": "Do Not Disturb",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.routines",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Do Not Disturb {$alexacontrol.data.onOff$} on {$alexacontrol.data.deviceOrAll$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.onOff", "type": "choice", "label": "On, off or toggle", "default": "On", "valueChoices": ["On", "Off", "Toggle"] },
            { "id": "alexacontrol.data.deviceOrAll", "type": "choice", "label": "Echo", "default": "All Echos", "valueChoices": ["All Echos"] }
          ]
        },
        {
          "id": "alexacontrol.act.routine",
          "name": "Run a routine",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.routines",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Run routine {$alexacontrol.data.routine$} on {$alexacontrol.data.device$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.routine", "type": "choice", "label": "Routine", "default": "", "valueChoices": [] },
            { "id": "alexacontrol.data.device", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] }
          ]
        },
        {
          "id": "alexacontrol.act.timerCreate",
          "name": "Create timer",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.routines",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Timer for {$alexacontrol.data.minutes$} minutes on {$alexacontrol.data.device$}" },
            { "lineFormat": "Name (optional) {$alexacontrol.data.label$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.minutes", "type": "number", "label": "Minutes", "default": 5, "minValue": 0.1, "maxValue": 1440, "allowDecimals": true },
            { "id": "alexacontrol.data.device", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] },
            { "id": "alexacontrol.data.label", "type": "text", "label": "Name", "default": "" }
          ]
        },
        {
          "id": "alexacontrol.act.timerCancel",
          "name": "Cancel all timers",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.routines",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Cancel all timers on {$alexacontrol.data.device$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.device", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] }
          ]
        },
        {
          "id": "alexacontrol.act.smartHome",
          "name": "Smart home device on, off or toggle",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.smarthome",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Smart home device {$alexacontrol.data.smartDevice$} {$alexacontrol.data.onOff$}" },
            { "lineFormat": "Ask through {$alexacontrol.data.device$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.smartDevice", "type": "choice", "label": "Smart home device", "default": "", "valueChoices": [] },
            { "id": "alexacontrol.data.onOff", "type": "choice", "label": "On, off or toggle", "default": "On", "valueChoices": ["On", "Off", "Toggle"] },
            { "id": "alexacontrol.data.device", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] }
          ]
        },
        {
          "id": "alexacontrol.act.smartVolume",
          "name": "Smart home device volume up or down",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.smarthome",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Volume {$alexacontrol.data.direction$} on smart home device {$alexacontrol.data.smartDevice$}" },
            { "lineFormat": "Ask through {$alexacontrol.data.device$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.direction", "type": "choice", "label": "Direction", "default": "Up", "valueChoices": ["Up", "Down"] },
            { "id": "alexacontrol.data.smartDevice", "type": "choice", "label": "Smart home device", "default": "", "valueChoices": [] },
            { "id": "alexacontrol.data.device", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] }
          ]
        },
        {
          "id": "alexacontrol.act.refresh",
          "name": "Refresh lists from Amazon",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.plugin",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Refresh {$alexacontrol.data.refreshWhat$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.refreshWhat", "type": "choice", "label": "What", "default": "All", "valueChoices": ["All", "Echo devices", "Routines", "Smart home devices"] }
          ]
        },
        {
          "id": "alexacontrol.act.reconnect",
          "name": "Reconnect to Amazon",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.plugin",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Reconnect to Amazon using the saved login" }
          ] } ] },
          "data": []
        },
        {
          "id": "alexacontrol.act.openLogin",
          "name": "Open Amazon login page",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.plugin",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Open the Amazon login page in a browser on the PC" }
          ] } ] },
          "data": []
        },
        {
          "id": "alexacontrol.act.login",
          "name": "Sign in to Amazon again",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.plugin",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Forget the saved Amazon login and start a new browser login" }
          ] } ] },
          "data": []
        },
        {
          "id": "alexacontrol.act.vmAnnounce",
          "name": "Voice Monkey announce",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.voicemonkey",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Announce on Speaker device ID {$alexacontrol.data.vmDevice$}" },
            { "lineFormat": "Text {$alexacontrol.data.text$}" },
            { "lineFormat": "Voice (optional) {$alexacontrol.data.vmVoice$} Chime (optional) {$alexacontrol.data.vmChime$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.vmDevice", "type": "text", "label": "Device ID", "default": "" },
            { "id": "alexacontrol.data.text", "type": "text", "label": "Text", "default": "" },
            { "id": "alexacontrol.data.vmVoice", "type": "text", "label": "Voice", "default": "" },
            { "id": "alexacontrol.data.vmChime", "type": "text", "label": "Chime", "default": "" }
          ]
        },
        {
          "id": "alexacontrol.act.vmTrigger",
          "name": "Voice Monkey trigger routine",
          "type": "communicate",
          "subCategoryId": "alexacontrol.sub.voicemonkey",
          "lines": { "action": [ { "language": "default", "data": [
            { "lineFormat": "Trigger Routine Trigger device ID {$alexacontrol.data.vmDevice$}" }
          ] } ] },
          "data": [
            { "id": "alexacontrol.data.vmDevice", "type": "text", "label": "Device ID", "default": "" }
          ]
        }
      ],
      "connectors": [
        {
          "id": "alexacontrol.conn.volume",
          "name": "Echo volume",
          "format": "Volume of {$alexacontrol.data.connDevice$}",
          "subCategoryId": "alexacontrol.sub.media",
          "data": [
            { "id": "alexacontrol.data.connDevice", "type": "choice", "label": "Echo", "default": "", "valueChoices": [] }
          ]
        }
      ],
      "events": [
        {
          "id": "alexacontrol.event.connection",
          "name": "Alexa connection changes",
          "format": "When the Alexa connection becomes $val",
          "type": "communicate",
          "valueType": "choice",
          "valueChoices": ["Disabled", "Connecting", "Login required", "Connected", "Error"],
          "valueStateId": "alexacontrol.state.connection",
          "subCategoryId": "alexacontrol.sub.plugin"
        }
      ],
      "states": [
        { "id": "alexacontrol.state.connection", "type": "choice", "desc": "Alexa connection", "default": "Disabled", "valueChoices": ["Disabled", "Connecting", "Login required", "Connected", "Error"], "parentGroup": "Alexa Control" },
        { "id": "alexacontrol.state.status", "type": "text", "desc": "Alexa status message", "default": "", "parentGroup": "Alexa Control" },
        { "id": "alexacontrol.state.loginUrl", "type": "text", "desc": "Alexa login URL", "default": "", "parentGroup": "Alexa Control" },
        { "id": "alexacontrol.state.lastError", "type": "text", "desc": "Alexa Control last error", "default": "", "parentGroup": "Alexa Control" },
        { "id": "alexacontrol.state.push", "type": "text", "desc": "Alexa push connection", "default": "Off", "parentGroup": "Alexa Control" },
        { "id": "alexacontrol.state.deviceCount", "type": "text", "desc": "Number of Echo devices found", "default": "0", "parentGroup": "Alexa Control" },
        { "id": "alexacontrol.state.vmStatus", "type": "text", "desc": "Voice Monkey status", "default": "Disabled", "parentGroup": "Alexa Control" }
      ]
    }
  ]
}
